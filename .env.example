# Local development works without Redis. Vercel/public hosting requires BOTH.
# Use the same database for Production and Preview to share the provider limit.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Production: identify this application with your real URL or contact email.
# Example: BetweenDistance/1.0 (+https://your-project.vercel.app)
APP_USER_AGENT=

# Optional: compatible providers can be changed without source changes.
NOMINATIM_BASE_URL=https://nominatim.openstreetmap.org
OSRM_BASE_URL=https://routing.openstreetmap.de/routed-car
